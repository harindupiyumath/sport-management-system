{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend (Spring Boot)",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/start-backend.ps1",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Backend",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/stop-backend.ps1",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Frontend (Port 5500)",
            "type": "shell",
            "command": "py -m http.server 5500 -d frontend",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Automated Tests",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/run_tests.ps1",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}

