// GitHub Codespaces: runs the Spring Boot backend in the cloud for demos.
// The backend starts automatically and is served on port 8080.
// Database / JWT settings come from Codespaces secrets (never from the repo).
{
  "name": "Sport Management System backend",
  "image": "mcr.microsoft.com/devcontainers/java:17",

  // SSH server so `gh codespace ssh` / `gh codespace logs` work from your own PC
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },

  // Secrets GitHub asks for when the codespace is created
  // (or set them once: GitHub -> Settings -> Codespaces -> Secrets).
  "secrets": {
    "DB_URL": { "description": "Neon JDBC URL, e.g. jdbc:postgresql://<host>:5432/neondb?sslmode=require" },
    "DB_USERNAME": { "description": "neondb_owner" },
    "DB_PASSWORD": { "description": "npg_Wt5vcblo1pOi" },
    "JWT_SECRET": { "description": "E0CCE3DE7B09E0BE16484A3674D7643B3E96C93530C913EB3B71920F952C3BB9" }
  },

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Backend API", "onAutoForward": "silent" }
  },

  // Start the backend every time the codespace starts (log: /tmp/backend.log).
  // setsid fully detaches it; a plain `&` gets killed when this step finishes.
  "postStartCommand": "setsid nohup bash .devcontainer/start-backend.sh > /tmp/backend.log 2>&1 < /dev/null & sleep 2",

  "customizations": {
    "codespaces": { "openFiles": ["RUN_INSTRUCTIONS.md"] },
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}
